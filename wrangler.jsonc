{
  "name": "portfolio",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-04-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": ".open-next/assets"
  },
  "r2_buckets": [
    {
      "binding": "PORTFOLIO_BUCKET",
      "bucket_name": "portfolio-assets"
    }
  ],
  // ADMIN_PASSWORD is NOT here on purpose — it's a runtime secret, set via:
  //   npx wrangler secret put ADMIN_PASSWORD
  "vars": {
    "R2_PUBLIC_URL": "https://pub-3d295c08d65c43f1b946e3df330ff420.r2.dev"
  }
}

